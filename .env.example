# Copy to .env.local for local development, and set the same variables in your
# hosting provider's environment settings for production.

# --- Site -------------------------------------------------------------------
# Public URL of the site (no trailing slash). Used for canonical URLs, the
# sitemap, robots.txt, Open Graph tags and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search-engine indexing stays OFF until this is "true". Turn it on at launch,
# after the placeholders have been replaced.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Inquiry form delivery (configure at least one) -------------------------
# Without a provider, the form validates input but tells visitors plainly that
# online submission isn't connected yet. Nothing is silently discarded.

# Option 1: Webhook. Receives a JSON POST for each inquiry (Zapier, Make, n8n,
# HubSpot/Pipedrive via automation, or your own API).
INQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as "Authorization: Bearer <secret>".
INQUIRY_WEBHOOK_SECRET=
# Optional: include uploaded files as base64 in the JSON payload.
INQUIRY_WEBHOOK_INCLUDE_FILES=false

# Option 2: Email via Resend (https://resend.com). Uploaded files are attached.
RESEND_API_KEY=
# Comma-separated list of recipients.
INQUIRY_EMAIL_TO=
# Must use a domain verified in Resend, e.g. "Website <website@yourcompany.com>"
INQUIRY_EMAIL_FROM=
