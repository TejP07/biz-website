# Copy to .env.local for local development. For GitHub Pages these values are
# set in .github/workflows/deploy-pages.yml.

# Public URL of the site, including any sub-folder (no trailing slash).
# Used for canonical URLs, the sitemap, robots.txt, Open Graph tags and structured data.
NEXT_PUBLIC_SITE_URL=https://tejp07.github.io/biz-website

# Sub-folder the site is served from. "/biz-website" on GitHub Pages;
# leave empty for local development or a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Search-engine indexing stays OFF until this is "true". Turn it on at launch,
# after the placeholders have been replaced.
NEXT_PUBLIC_ALLOW_INDEXING=false
